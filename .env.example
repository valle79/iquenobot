# === IquenoBot Environment Variables ===
# Copy this file to .env and fill in the values

# PostgreSQL
POSTGRES_PASSWORD=changeme_secure_password

# Spring Boot
SPRING_PROFILES_ACTIVE=docker
DATASOURCE_URL=jdbc:postgresql://postgres:5432/iquenobot
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=changeme_secure_password

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=your-256-bit-jwt-secret-here-minimum-32-characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Crypto (for sensitive data encryption)
CRYPTO_SECRET=your-16-char-crypto-key

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# URLs
BASE_URL=https://iquenobot.your-domain.com
CORS_ORIGINS=https://iquenobot.your-domain.com

# Uploads
UPLOAD_PATH=uploads

# Storage (local | s3). Use s3 for AWS S3, Cloudflare R2, MinIO or GCS (S3 API)
STORAGE_PROVIDER=local
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRY_MINUTES=60

# Logging
LOG_LEVEL=INFO
