# -- Frontend build stage
FROM node:22-alpine AS frontend-build
WORKDIR /app
COPY frontendiquenobot/package.json frontendiquenobot/pnpm-lock.yaml frontendiquenobot/pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY frontendiquenobot/ .
RUN pnpm build

# -- Backend build stage
FROM maven:3.9.9-amazoncorretto-21-alpine AS backend-build
WORKDIR /app
COPY pom.xml .
RUN mvn dependency:go-offline -B
COPY src ./src
RUN mvn clean package -DskipTests -B

# -- Runtime stage
FROM amazoncorretto:21-alpine
RUN apk add --no-cache nginx

WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 appgroup && \
    adduser -D -u 1001 -G appgroup appuser

# Copy backend jar
COPY --from=backend-build /app/target/*.jar app.jar

# Copy frontend build
COPY --from=frontend-build /app/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx/nginx.conf /etc/nginx/http.d/default.conf

# Copy entrypoint
COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Create uploads directory
RUN mkdir -p /app/uploads && chown -R appuser:appgroup /app /usr/share/nginx/html

USER appuser

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=60s \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/actuator/health || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
